# ============================================================================
# QuickGift — Environment Variables
# Copy this file to backend/.env and fill in the values marked REQUIRED.
# Everything else has a safe default for local development.
# ============================================================================

# ---- Database (REQUIRED) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=quickgift

# ---- Auth (REQUIRED) ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Server ----
PORT=4000
# Set this to your actual frontend URL(s) in production, e.g. https://quickgift.yourdomain.com
CORS_ORIGIN=*

# ---- Payments (spec section 25) ----
# mock = no credentials needed, checkout always "succeeds" — good for building/testing.
# razorpay = REAL integration, already implemented in src/services/paymentProvider.js
#   using plain HTTPS calls (no SDK to install). Get these three from
#   https://dashboard.razorpay.com (Settings -> API Keys, Settings -> Webhooks).
PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ---- Exchange rates (spec section 8/47) ----
# Live by default via the free open.er-api.com API — no key needed, nothing to set.
# Only set these if you want a different/paid provider:
# EXCHANGE_RATE_API_URL=
# EXCHANGE_RATE_API_KEY=

# ---- Email (spec section 29) ----
# Real integration via Resend's HTTP API (https://resend.com — free tier, no SDK needed).
# Leave unset to log emails to console during development.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=QuickGift <onboarding@resend.dev>

# ---- SMS / OTP (spec section 28/29) ----
# Real integration via Twilio's HTTP API (https://twilio.com — no SDK needed).
# Leave unset: OTP requests still work, the code is logged to the server console
# and returned in the API response for local testing only.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ---- Google login (spec section 28) ----
# GOOGLE_CLIENT_ID=

# ---- Courier tracking (spec section 11/24) ----
# COURIER_API_KEY=
